# Set these in Vercel for the frontend project as well as in frontend/.env for local work.
# Use your actual public domain after it is connected to Vercel.
VITE_SITE_URL=https://dhungana-stores.vercel.app

# Set this after assigning a dedicated staff domain to the frontend Vercel project,
# for example https://staff.example.com. Until then, leave it blank.
VITE_STAFF_URL=

# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/bishnu_dhungana_stores"

# Server port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# JWT secret — use a long random string in production (e.g. openssl rand -hex 32)
# Development-only example. Set a unique random 32+ character value in production.
JWT_SECRET=bishnu-dhungana-stores-dev-secret-2024

# Email used to deliver password reset links (configure with your mail provider)
FRONTEND_URL=http://localhost:3000
# Optional dedicated staff portal origin (for production, e.g. https://staff.example.com)
STAFF_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional image uploads (Cloudinary). Configure all three to enable uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Set to the number of trusted reverse proxies in production (often 1).
TRUST_PROXY_HOPS=0

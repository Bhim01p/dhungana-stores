// Prisma Schema -- Bishnu and Dhungana Stores
// Backend: Node.js + Express + TypeScript
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------
// ENUMS
// ---------------------------------------------

enum AdminRole {
  ADMIN
  STAFF
}

enum Unit {
  kg
  gram
  litre
  ml
  packet
  box
  piece
  dozen
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  NOT_REQUIRED
  REFUNDED
}

enum PasswordResetAccountType {
  CUSTOMER
  ADMIN
}

// ---------------------------------------------
// ADMIN USER
// ---------------------------------------------

model AdminUser {
  id        String    @id @default(cuid())
  username  String    @unique
  recoveryEmail String? @unique @map("recovery_email")
  password  String
  role      AdminRole @default(ADMIN)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("admin_users")
}

// ---------------------------------------------
// CUSTOMER
// ---------------------------------------------

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String   @unique
  password  String   // bcrypt hash
  passwordChangedAt DateTime? @map("password_changed_at")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@map("customers")
}

model PasswordResetToken {
  id          String                  @id @default(cuid())
  tokenHash   String                  @unique @map("token_hash")
  accountType PasswordResetAccountType @map("account_type")
  accountId   String                  @map("account_id")
  expiresAt   DateTime                @map("expires_at")
  createdAt   DateTime                @default(now()) @map("created_at")

  @@index([accountType, accountId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------
// CATEGORY
// ---------------------------------------------

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryTree")

  products    Product[]

  @@index([parentId])
  @@map("categories")
}

// ---------------------------------------------
// PRODUCT
// ---------------------------------------------

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  brand             String?
  sku               String?  @unique
  price             Decimal  @db.Decimal(10, 2)
  unit              Unit
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(10)
  image             String?
  active            Boolean  @default(true)
  featured          Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]

  @@map("products")
}

// ---------------------------------------------
// ORDER
// ---------------------------------------------

model Order {
  id             String        @id @default(cuid())
  orderNumber    String        @unique
  guestLookupTokenHash String? @unique @map("guest_lookup_token_hash")
  stockReserved  Boolean       @default(false) @map("stock_reserved")
  customerName   String
  phone          String
  email          String?
  address        String
  landmark       String?
  notes          String?
  subtotal       Decimal       @db.Decimal(10, 2)
  deliveryCharge Decimal       @default(0) @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(PENDING)
  orderStatus    OrderStatus   @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Optional link to a registered customer
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])

  orderItems  OrderItem[]

  @@map("orders")
}

// ---------------------------------------------
// ORDER ITEM
// ---------------------------------------------

model OrderItem {
  id          String   @id @default(cuid())
  productName String
  unit        Unit
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  @@map("order_items")
}

// ---------------------------------------------
// PAYMENT METHOD (QR-based)
// ---------------------------------------------

model PaymentMethod {
  id          String   @id @default(cuid())
  name        String
  qrImageUrl  String
  accountInfo String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("payment_methods")
}
